# Copia este fichero a .env (que NO se sube a GitHub) y rellena los valores.
# En Coolify, estas mismas variables van en Environment Variables.

# Puerto en el que escucha la app. En Coolify, el mismo que pongas en "Ports Exposes".
PORT=3210

# Zona horaria del servidor. Las reglas de cancelación (12 horas) dependen de la hora.
TZ=Europe/Madrid
